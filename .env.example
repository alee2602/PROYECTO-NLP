# Copiar a .env (ya excluido de git) y ajustar según el proveedor.

# LM Studio local (default): levantar el servidor en LM Studio y dejar estos
# valores tal cual, o cambiar el modelo cargado en LM Studio.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen/qwen3.5-9b

# Para usar un proveedor en la nube en vez de LM Studio, cambiar por ejemplo a:
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=claude-haiku-...
